# =============================================================================
# DataPilotAI — Environment Variables Example
# Copy this file to .env and fill in your values.
# Never commit your real .env file to version control.
# =============================================================================


# =============================================================================
# SERVER
# =============================================================================

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173


# =============================================================================
# AUTHENTICATION
# =============================================================================

JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# OPTIONAL — Google OAuth (set if using Google Sign-In)
GOOGLE_CLIENT_ID=


# =============================================================================
# DATABASE — MongoDB
# =============================================================================

MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/datapilot?retryWrites=true&w=majority


# =============================================================================
# CACHE — Redis
# =============================================================================

# OPTIONAL — TCP Redis URL for BullMQ background jobs
# Required only if you want async document processing via queues.
# Upstash REST (below) is used for response caching; this is separate.
REDIS_URL=

# OPTIONAL — Upstash Redis REST (response caching, rate limiting)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token


# =============================================================================
# VECTOR DATABASE — Qdrant
# =============================================================================

QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=documents


# =============================================================================
# OBJECT STORAGE — AWS S3
# =============================================================================

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_BUCKET=your-datapilot-bucket


# =============================================================================
# LLM PROVIDERS
# =============================================================================

# Primary provider — controls which API routes all groq-tagged models through.
# Valid values: groq | openrouter | gemini
PRIMARY_LLM_PROVIDER=groq

# -----------------------------------------------------------------------------
# Groq — REQUIRED — Primary LLM Provider
# All groq-tagged models (llama-3.3-70b, llama-3.1-8b, qwen3-32b) require this.
# Get your key at https://console.groq.com
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_BASE_URL=https://api.groq.com/openai/v1

# -----------------------------------------------------------------------------
# OpenRouter — OPTIONAL — Additional free/paid models (set if using OpenRouter models)
# Required for openrouter-tagged models (GPT-4o, Claude, DeepSeek, etc.)
# Get your key at https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Gemini — OPTIONAL — Google Gemini direct API (fallback)
# Required for gemini-tagged models (gemini-2.5-flash, gemini-2.5-pro)
# Get your key at https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# -----------------------------------------------------------------------------
# Freemodel — OPTIONAL — Claude proxy (paid, for Anthropic models)
# Required for freemodel-tagged models (claude-sonnet, claude-haiku, claude-opus)
# Get your key at https://cc.freemodel.dev
# -----------------------------------------------------------------------------
FREEMODEL_API_KEY=
FREEMODEL_BASE_URL=https://cc.freemodel.dev


# =============================================================================
# LLM TUNING
# =============================================================================

LLM_TIMEOUT=20000
MAX_RETRIES=3
MAX_TOKENS=500
TEMPERATURE=0.1
TOP_P=0.2


# =============================================================================
# EMBEDDINGS — Jina AI
# =============================================================================

# REQUIRED — Used for document chunking and vector search
# Get your key at https://jina.ai
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# =============================================================================
# WEB SEARCH — Tavily
# =============================================================================

# OPTIONAL — Required for the Research Agent (web search mode)
# Get your key at https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxx


# =============================================================================
# PAYMENTS — Razorpay
# =============================================================================

# OPTIONAL — Required only for subscription/payment features
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret


# =============================================================================
# EMAIL — Nodemailer (Gmail)
# =============================================================================

# OPTIONAL — Required for email verification and password reset
EMAIL_USER=your-app@gmail.com
EMAIL_PASS=your_gmail_app_password


# =============================================================================
# OBSERVABILITY — LangSmith
# =============================================================================

# OPTIONAL — Enables LangSmith tracing for all LangChain/LangGraph calls.
# Set LANGCHAIN_TRACING_V2=true and provide LANGSMITH_API_KEY to enable.
# Dashboard: https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=DataPilotAI
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# =============================================================================
# RAG CONFIGURATION
# =============================================================================

# Mode: strict (only answer from documents) | hybrid (fallback to LLM knowledge)
RAG_MODE=strict
RAG_THRESHOLD=0.65
RAG_ALIGNMENT_THRESHOLD=0.35
RAG_TOP_K=5


# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=30
DAILY_QUOTA=200
