{
  "name": "ai-saas-backend",
  "version": "2.0.0",
  "description": "DataPilotAI — Production AI Document Platform (LangChain + LangGraph + LangSmith)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "npx tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --dts --out-dir dist",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@langchain/anthropic": "^0.3.0",
    "@langchain/community": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/google-genai": "^0.1.0",
    "@langchain/groq": "^0.1.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.3.0",
    "@langchain/qdrant": "^0.1.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "@upstash/redis": "^1.37.0",
    "@xmldom/xmldom": "^0.9.10",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.2",
    "canvas": "^3.2.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^0.3.0",
    "langsmith": "^0.2.0",
    "mongoose": "^9.5.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^1.0.1",
    "pdfjs-dist": "^5.7.284",
    "razorpay": "^2.9.6",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.0",
    "winston": "^3.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.2.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "better-sqlite3": "^11.3.0",
    "mongodb": "^6.17.0"
  }
