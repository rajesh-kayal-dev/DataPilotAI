{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Production build: tighter checks, no test files
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": false,
    "declarationMap": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
